# ExplorerOS-Mobile environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase Dashboard → Project Settings → API). The real `.env` is gitignored
# so keys are never committed.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Maps Platform key (Google Cloud Console → APIs & Services → Credentials).
# Used for the in-app map AND for driving-distance lookups on Nearby Gems / Around
# Me (Distance Matrix API). Enable both "Maps SDK for Android" and "Distance
# Matrix API" for this key, or driving distances silently fall back to
# straight-line.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
